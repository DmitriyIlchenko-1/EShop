<html lang="en">
<head>
    <meta charset="utf-8"/>
    <title>Internal Server Error</title>
    <style>
        .page {
            max-width: 50rem;
            margin: 50px auto;
            --color-error-h: 342;
            --color-error-s: 89%;
            --color-error-l: 48%;
        }
        
        p{
            margin-top: 2rem;
            background-color: hsla(var(--color-error-h),
            var(--color-error-s),
            var(--color-error-l), 0.2);
            padding: 2rem;
        }
        

    </style>
</head>
<body>
<div class="page">
    <h1>Error details</h1>
    <div>
        <img src="images/error-image.png" alt=""/>
    </div>
    <p>
        An error has occured during the request. Try refreshing your page later.
    </p>
</div>

</body>

</html>
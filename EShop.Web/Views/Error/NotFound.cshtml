@{
    ViewBag.Title = "Not found";
}


<div class="section section--content-middle spacing-style gap-style color-scheme-1" style="
        --padding-block-start: max(20px, calc(var(--spacing-scale) * 48px));
        --padding-block-end: max(20px, calc(var(--spacing-scale) * 48px));
        --gap: max(24px, calc(var(--gap-scale, 1.0) * 28px))">
   
    <h1>Not Found</h1>
    <p>The resource you've tried to access hasn't been found. Try refreshing the page later if you're confident it's a mistake.</p>
    <div>
        <a class="button" asp-action="Homepage">
            Home
        </a>
    </div>
</div>
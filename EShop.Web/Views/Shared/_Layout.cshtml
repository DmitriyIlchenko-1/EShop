            --icon-size-2xs: 0.96rem;
            --icon-size-xs: 1.36rem;
            --icon-size-sm: 2rem;
            --icon-size-md: 2.2rem;
            --icon-size-lg: 2.4rem;
            --icon-size-xl: 2.6rem;


            /*|| Gaps*/
            --gap-3xs: 0.2rem;
            --gap-2xs: 0.48rem;
            --gap-xs: 0.8rem;
            --gap-sm: 1.12rem;
            --gap-md: 1.44rem;
            --gap-lg: 1.6rem;
            --gap-xl: 2rem;
            --gap-2xl: 3.2rem;
            --gap-3xl: 4.8rem;


            --product-thumbnail-bagde-offset: .4rem;
            
            /*Borders*/
            --style-border-radius-buttons: 10px; /*from settings*/


            /*|| Buttons*/
            --minimum-touch-target: 44px;
            --minimum-field-touch-target: 4.4rem;
            --button-padding-inline: 24px;
            --button-padding-block: 16px;
            --btn-primary-border-width: 2px;
            --btn-secondary-border-width: 1px;

            /*Z-index*/
            --layer-base: 0;
            --layer-flat: 1;
            --layer-raised: 2;
            --layer-heightened: 4;
            --layer-sticky: 8;
            --layer-window-overlay: 10;
            --layer-header-menu: 12;
            --layer-overlay: 16;
            --layer-menu-drawer: 18;
            --layer-temporary: 20;

            /*|| Spacing*/
            --space-unit: .4rem;

            --padding-3xs: 0.2rem;
            --padding-2xs: 0.4rem;
            --padding-xs: 0.8rem;
            --padding-sm: 1.12rem;
            --padding-md: 1.28rem;
            --padding-lg: 1.6rem;
            --padding-xl: 2rem;
            --padding-2xl: 2.4rem;
            --padding-3xl: 2.8rem;
            --padding-4xl: 3.2rem;
            --padding-5xl: 4.8rem;
            --padding-6xl: 6.4rem;

            --margin-3xs: 0.2rem;
            --margin-2xs: 0.48rem;
            --margin-xs: 0.8rem;
            --margin-sm: 1.12rem;
            --margin-md: 1.28rem;
            --margin-lg: 1.6rem;
            --margin-xl: 2rem;
            --margin-2xl: 2.4rem;
            --margin-3xl: 2.8rem;
            --margin-4xl: 3.2rem;
            --margin-5xl: 4.8rem;
            --margin-6xl: 8rem;


            --spacing-scale-sm: 0.6;
            --spacing-scale-md: 0.7;
            --spacing-scale-default: 1.0;
            --spacing-scale-lg: 1.2;

            --letter-spacing--heading-tight: -0.03em;
            --letter-spacing--heading-normal: 0em;
            --letter-spacing--heading-loose: 0.03em;

            /*|| Typography*/

            --font-body-family: 'DM Sans', sans-serif;
            --font-body-style: normal;
            --font-body-weight: 400;
            --font-body--size: 16;

            --font-heading--family: 'Inter', sans-serif;
            --font-heading--style: normal;
            --font-heading--weight: 700;

            --font-subheading--style: normal;
            --font-subheading--family: 500;
            --font-subheading--weight: 'Fira Sans', sans-serif;


            /*  !*Heading Font Sizes
              We have our font max breakpoint set to 1000px.
              It means that as soon as the viewport reaches that number,
              the font-size will set to the specified user value.
              The value is hardcoded in here and equals 48px.

              To make font-size fluid - we have to make it scale down with respect
              to those 48 pixels it can maximum get in 1000px viewport.
              4.8vw is going to be our 'scaled down 48 pixels' at any given viewport smaller than 1000px.
              The formula is (absoluteSize / breakpoint) * 100.

              What's defined by the design:
              1. The upper-bound limit along with the max breakpoint.
              Traditionally, 48px (3rem) is the biggest size specified in the last media query for the last font breakpoint.

              2. The max breakpoint is also determined by the design - we do not want the font size to grow anymore after reaching it.

              3. The bottom-bound: the design defines possible sizes the headers can be and each header's bottom-bound is the size of the next heading in the hierarchy.
              The bottom-bound is for the viewport width that isn't enough to get to 4.8vw.
              We shouldn't be able make a heading less than the size of the next level header.
              For example, if h4 is clamp(3.5rem, 7.2vw, 4.5rem) - then h3's bottom-bound must be 4.5rem. (h3 shouldn't become smaller than h4).

              We can jump over size values depending on the design values available. If you can set any heading to 48, 56 or 72px (that's the design possible values),
              and you choose to set h1 to 48px and h2 to 72px, the h2's bottom-bound should be 3.5rem (56px).
              The h2 can get smaller down to 3.5rem since there's no heading for that value. - this behaviour is something dictated by the design.


              What's defined by the fluid typography:
              1. The ideal value, which scales down the font size taking into account the current viewport width and 48px font-size
              that it has to adopt for that viewport size.


              The sizes used are 56px, 48px, 32px, 24px, 14px, 12px. */

            --font-size--h1: clamp(4.8rem, 5.6vw, 5.6rem);
            --font-size--h2: clamp(3.6rem, 4.8vw, 4.8rem);
            --font-size--h3: 3.2rem;
            --font-size--h4: 2.4rem;
            --font-size--h5: 1.7rem;
            --font-size--h6: 1.2rem;


            /*Focus*/
            --focus-outline-width: 0.2rem;
            --focus-outline-style: solid;
            --focus-outline-color: #0071e3;
            --focus-outline-offset: 0.2rem;


            /*|| Product Cards*/
            --product-card-corner-radius: 7px;

            /*|| Modals*/
            --modal-border-radius: 16px;


            /*Line Heights*/
            --line-height--body-tight: 1.2;
            --line-height--body-normal: 1.8;
            --line-height--body-loose: 1.6;


            --line-height--heading-tight: 1;
            --line-height--heading-normal: 1.1;
            --line-height--heading-loose: 1.3;


            /*|| Inputs. Search*/
            --input-border-width: 1px;
            --input-border-opacity: .6;
            --input-border-radius: 10px;
            --search-input-border-radius: 55px;
            --color-input-border-success-rgb: 22, 171, 0;
            --color-input-border-error-rgb: 255, 0, 0;
            --color-text-danger: #d40f0f;

            /*Animation*/
            --animation-speed: 0.125s;
            --animation-easing: ease-in-out;

            /*|| Variants*/
            --variant-border-width: 1px;
            --variant-border-style: solid;
            --variant-outline-offset: 2px;

            /*|| Variants - Color Swatches*/
            --color-swatch-input-border-radius: 50%;
            --color-swatch-input-width: 24px;
            --color-swatch-input-height: 24px;
            --color-swatch-outer-circle-ratio: 1.25;


            /*|| BORDERS*/
            --border-radius-xs: 0.2rem;
            --border-radius-sm: 0.6rem;
            --border-radius-md: 0.8rem;
            --border-radius-50: 50%;
            --border-radius-lg: 1rem;


            /*START*/
            /*This shouldn't be in this file, my guess (don't know for sure) is that this is done with some sort of server-side parser that produces all these variables as its output*/
            --font-h1--weight: var(--font-heading--weight);
            --font-h1--letter-spacing: var(--letter-spacing--heading-normal);
            --font-h1--size: var(--font-size--h1);
            --font-h1--family: var(--font-heading--family);
            --font-h1--style: var(--font-heading--style);
            --font-h1--case: none;
            --font-h1--line-height: var(--line-height--heading-loose);
            --font-h2--weight: var(--font-heading--weight);
            --font-h2--letter-spacing: var(--letter-spacing--heading-normal);
            --font-h2--size: var(--font-size--h2);
            --font-h2--family: var(--font-heading--family);
            --font-h2--style: var(--font-heading--style);
            --font-h2--case: none;
            --font-h2--line-height: var(--line-height--heading-loose);
            --font-h3--weight: var(--font-heading--weight);
            --font-h3--letter-spacing: var(--letter-spacing--heading-normal);
            --font-h3--size: var(--font-size--h3);
            --font-h3--family: var(--font-heading--family);
            --font-h3--style: var(--font-heading--style);
            --font-h3--case: none;
            --font-h3--line-height: var(--line-height--heading-loose);
            --font-h4--weight: var(--font-heading--weight);
            --font-h4--letter-spacing: var(--letter-spacing--heading-normal);
            --font-h4--size: var(--font-size--h4);
            --font-h4--family: var(--font-heading--family);
            --font-h4--style: var(--font-heading--style);
            --font-h4--case: none;
            --font-h4--line-height: var(--line-height--heading-loose);
            --font-h5--weight: var(--font-heading--weight);
            --font-h5--letter-spacing: var(--letter-spacing--heading-normal);
            --font-h5--size: var(--font-size--h5);
            --font-h5--family: var(--font-heading--family);
            --font-h5--style: var(--font-heading--style);
            --font-h5--case: none;
            --font-h5--line-height: var(--line-height--heading-loose);
            --font-h6--weight: var(--font-heading--weight);
            --font-h6--letter-spacing: var(--letter-spacing--heading-normal);
            --font-h6--size: var(--font-size--h6);
            --font-h6--family: var(--font-subheading--family);
            --font-h6--style: var(--font-subheading--style);
            --font-h6--case: none;
            --font-h6--line-height: var(--line-height--heading-loose);
            /*END*/

            /*|| Variant */
            --variant-border-color: #6f7171;
            --variant-border-opacity: 0.4;
            --variant-border-checked-color: #000000;

            --star-color-rgb: 255 159 28;


            /*Button colors*/
            --color-danger-primary-button-background: rgb(255, 255, 255);
            --color-danger-primary-button-text: rgb(244, 10, 31);
            --color-danger-primary-button-hover-background: rgb(255, 255, 255);
            --color-danger-primary-button-hover-text: rgb(255, 0, 0);
            --color-danger-primary-button-border: rgb(0, 0, 0);
            --color-danger-primary-button-hover-border: rgb(0, 0, 0);

            --icon-button-danger-action-bg-color: rgb(209, 7, 7);
            --icon-button-danger-action-color: rgb(235, 234, 234);


            --badge-info-bg-color: rgb(0, 90, 225);
            --badge-info-color: rgb(255, 255, 255);

            --product-card-price-color: rgb(0, 0, 0);
            --product-label-text--refurbished: #ffffff;
            --product-label-gradient--refurbished: linear-gradient(145deg, rgba(42, 156, 44, 1) 20%, rgba(42, 156, 44, 0.76) 82%);
            --product-label-text--sale: #ffffff;
            --product-label-gradient--sale: linear-gradient(144deg, rgba(244, 43, 65, 0.8), rgb(218, 50, 67) 97%, rgba(247, 23, 23, 0.8) 97.482%);

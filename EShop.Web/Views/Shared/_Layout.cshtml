@using EShop.Infrastructure.Extensions
@using EShop.Web.Components
@using EShop.Web.Controllers
<!DOCTYPE html>
<html lang="en-US" class="js">
<head>
    <meta charset="utf-8"/>
    <meta name="viewport" content="width=device-width,initial-scale=1,maximum-scale=1"/>
    @await Component.InvokeAsync("Antiforgery")
    @(await Component.InvokeAsync<NotificationViewComponent>())


    <title>@ViewBag.Title</title>
    <link href="~/css/main.css" rel="stylesheet" type="text/css"/>
    <link href="~/css/hero.css" rel="stylesheet" type="text/css"/>
    <link href="~/css/utility-bar.css" rel="stylesheet" type="text/css"/>
    <link href="~/css/component-list-social.css" rel="stylesheet" type="text/css"/>
    <link href="~/css/gallery.css" rel="stylesheet" type="text/css"/>
    <link href="~/css/header.css" rel="stylesheet" type="text/css"/>
    <link href="~/css/menu.css" rel="stylesheet" type="text/css"/>
    <link href="~/css/mega-nav.css" rel="stylesheet" type="text/css"/>
    <link href="~/css/customer.css" rel="stylesheet" type="text/css"/>
    <link href="~/css/product-details.css" rel="stylesheet" type="text/css"/>
    <link href="~/css/utils.css" rel="stylesheet" type="text/css"/>
    <link href="~/css/cart-items.css" rel="stylesheet" type="text/css"/>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/notyf@3/notyf.min.css">
  
    <resources type="HeadScript"/>
    <partial name="_JQueryScripts"/>
    <script type="module" src="~/lib/notyf/notyf.es.js"></script>
    <script type="module" src="~/js/utilities.js"></script>
    <script type="module" src="~/js/critical.js"></script>
    <script type="module" src="~/js/header.js"></script>
    <script type="module" src="~/js/main.js"></script>
    <script type="module" src="~/js/variant-selector.js"></script>
    <script type="module" src="~/js/cart-form.js"></script>
    <script type="module" src="~/js/media-gallery.js"></script>
    <script type="module" src="~/js/cart-items.js"></script>
    <script type="module" src="~/js/checkout-flow.js"></script>
    <script type="module" src="~/js/cart-drawer.js"></script>
    <script type="module" src="~/js/product-form.js"></script>

    <!--Font imports-->
    <partial name="_FontImports"/>
    <partial name="_CssVariables"/>

</head>
<body class="page-width-narrow">
<partial name="_Header"/>
<main>
    @RenderBody()
</main>
@{
    if (Context.Request.RouteValues.GetValueOrDefaultAs<string>("action") 
        != nameof(ShoppingCartController.Cart))
    {
        @await Component.InvokeAsync("CartDrawer")
    }
}
<div class="overlay overlay--fixed overlay--solid js-overlay"></div>
<partial name="_ValidationScripts"/>
<resources type="FootScript"/>
</body>
 
</html>
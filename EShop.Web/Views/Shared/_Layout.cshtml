<body class="page-width-narrow  ">
<partial name="_Header"/>
<main>
    @RenderBody()
</main>
<div class="overlay overlay--nav overlay--solid js-overlay" style="--overlay-layer: var(--layer-overlay) "></div>

</body>
@(await RenderSectionAsync("Scripts", false))
<script  src="~/lib/notyf/notyf.min.js"></script>
</html>
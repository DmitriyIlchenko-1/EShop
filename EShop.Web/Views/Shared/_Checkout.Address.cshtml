@using EShop.Web.Controllers
@using Microsoft.AspNetCore.Mvc.TagHelpers
@model EShop.Web.Models.Checkout.CheckoutShippingAddressModel




<div id="checkout-selectAddress-load" data-existing-address-count="@Model.ExistingAddresses.Count">
    <partial name="_Checkout.SelectAddress" model="Model"/>
</div>
 
<div class="js-form-panel">
    @{
         
        <form method="post"
              class="js-checkout-address-form">
            <div id="checkout-addUpdateAddressForm-load">
                @{
                    var dataDictNewAddress = new ViewDataDictionary(ViewData);
                    dataDictNewAddress.TemplateInfo.HtmlFieldPrefix = nameof(Model.NewAddress);
                    @await Html.PartialAsync("_Checkout.CreateOrUpdateAddress", Model.NewAddress, dataDictNewAddress)
                }
                
            </div>
        </form>
    }
</div>

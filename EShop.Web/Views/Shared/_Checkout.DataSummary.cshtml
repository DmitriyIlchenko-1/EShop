@using EShop.Infrastructure.Extensions
@model EShop.Web.Models.Checkout.CheckoutDataSummaryModel

@{
    var shippingAddress = Model.ShippingAddress;
}
<dl class="grid gap-md text md:grid-cols-2">
    <div>
        <dt class="h5">Shipping address</dt>
        <dd>
            <dl>
                <dt class="visually-hidden">First and last name</dt>
                <dd>@shippingAddress.Fullname</dd>
                <dt class="visually-hidden">Address 1</dt>
                <dd>@shippingAddress.AddressLine1</dd>
                <div eh-if="@(!shippingAddress.AddressLine2.IsEmpty())">
                    <dt class="visually-hidden">Address 2</dt>
                    <dd>@shippingAddress.AddressLine2</dd>
                </div>
                <dt class="visually-hidden">Phone</dt>
                <dd>@shippingAddress.PhoneNumber</dd>
                <dt class="visually-hidden">City name</dt>
                <dd>@shippingAddress.CityName</dd>
                <dt class="visually-hidden">Zip code</dt>
                <dd>@shippingAddress.ZipCode</dd>
            </dl>
        </dd>
        <dd >
            <a class="  account__edit-button icon-button icon-button--round"
               aria-label="Edit address" asp-action="ShippingAddress">
                <svg class="icon" aria-hidden="true" focusable="false"
                     xmlns="http://www.w3.org/2000/svg" width="200" height="200"
                     viewBox="0 0 1025 1023">
                    <path fill="#000000"
                          d="M896.428 1023h-768q-53 0-90.5-37.5T.428 895V127q0-53 37.5-90t90.5-37h576l-128 127h-384q-27 0-45.5 19t-18.5 45v640q0 27 19 45.5t45 18.5h640q27 0 45.5-18.5t18.5-45.5V447l128-128v576q0 53-37.5 90.5t-90.5 37.5zm-576-464l144 144l-208 64zm208 96l-160-159l479-480q17-16 40.5-16t40.5 16l79 80q16 16 16.5 39.5t-16.5 40.5z"/>
                </svg>
            </a>
        </dd>
    </div>
    @* <div> *@
    @*     <dt class="h5 m-0">Shipping method</dt> *@
    @*     <dd class="flex items-center gap-3xs"> *@
    @*         In-store pickup *@
    @*         <a style="align-self: center" class="inline-flex icon-button" href="#"> *@
    @*             <svg class="icon" aria-hidden="true" focusable="false" *@
    @*                  xmlns="http://www.w3.org/2000/svg" width="18" height="18" *@
    @*                  viewBox="0 0 1025 1023"> *@
    @*                 <path fill="#000000" *@
    @*                       d="M896.428 1023h-768q-53 0-90.5-37.5T.428 895V127q0-53 37.5-90t90.5-37h576l-128 127h-384q-27 0-45.5 19t-18.5 45v640q0 27 19 45.5t45 18.5h640q27 0 45.5-18.5t18.5-45.5V447l128-128v576q0 53-37.5 90.5t-90.5 37.5zm-576-464l144 144l-208 64zm208 96l-160-159l479-480q17-16 40.5-16t40.5 16l79 80q16 16 16.5 39.5t-16.5 40.5z"/> *@
    @*             </svg> *@
    @*         </a> *@
    @*     </dd> *@
    @* </div> *@
    <div eh-if="@(!Model.PaymentMethodName.IsEmpty())">
        <dt class="h5 m-0">Payment method</dt>
        <dd class="flex items-center gap-3xs">@Model.PaymentMethodName
            <a class="account__edit-button icon-button icon-button--round"
               aria-label="Edit address" asp-action="PaymentList">
                <svg class="icon" aria-hidden="true" focusable="false"
                     xmlns="http://www.w3.org/2000/svg" width="200" height="200"
                     viewBox="0 0 1025 1023">
                    <path fill="#000000"
                          d="M896.428 1023h-768q-53 0-90.5-37.5T.428 895V127q0-53 37.5-90t90.5-37h576l-128 127h-384q-27 0-45.5 19t-18.5 45v640q0 27 19 45.5t45 18.5h640q27 0 45.5-18.5t18.5-45.5V447l128-128v576q0 53-37.5 90.5t-90.5 37.5zm-576-464l144 144l-208 64zm208 96l-160-159l479-480q17-16 40.5-16t40.5 16l79 80q16 16 16.5 39.5t-16.5 40.5z"/>
                </svg>
            </a></dd>
    </div>
</dl>
            
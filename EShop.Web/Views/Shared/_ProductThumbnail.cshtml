@model  EShop.Web.Models.Catalog.ProductThumbnail


<div class="card mb-4">
    <a href="~/@Model.Slug" title="@Model.Name">
        <img alt="@Model.Name" class="card-img-top" src="@Model.ThumbnailUrl">
        <div class="card-body">
            <h5 class="card-title product-name">@Model.Name </h5>
            <p class="card-text">
                @Model.CalculatedProductPrice.PriceString   
                @if (Model.CalculatedProductPrice.PercentOfSaving > 0)
                {
                    <span class="product-price-saving">
                        -@Model.CalculatedProductPrice.PercentOfSaving%  
                    </span>
                    <br>
                    <span class="product-price-regular">
                        @Model.CalculatedProductPrice.OldPriceString    
                    </span>
                    
                }
            </p>
            <ul class="list-inline">
                <li>@Model.RatingAverage    </li>
                @if (Model.ReviewsCount > 0)
                {
                    <li>
                        <span>@Model.ReviewsCount</span>
                    </li>
                }
            </ul>
        </div>
    </a>
</div>
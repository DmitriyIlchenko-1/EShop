@using EShop.Web.Components
@model EShop.Web.Models.Checkout.CheckoutConfirmModel
@{
    ViewBag.Title = "Order confirmation";
}

<div class="section section--content-middle color-scheme-1 spacing-style"
     style=" --padding-block-start: max(20px, calc(var(--spacing-scale) * 68px)); --padding-block-end:max(20px, calc(var(--spacing-scale) * 68px))">
    <div class="customer checkout">
        <h1 class="h2">Order confirmation</h1>
        <form asp-action="Confirm" method="post">
            <div class="checkout__container">
                <div class="checkout__main-flow">
                    <div class="checkout__order-data-summary-container">
                        <partial name="_Checkout.DataSummary" model="@Model.SummaryModel"/>
                    </div>
                    <div class="flex flex-col gap-md">
                        @foreach (var error in Model.Errors)
                        {
                            <div class="alert alert--error radius-sm" role="alert">
                                @error
                            </div>
                        }
                    </div>
                </div>
                @await Component.InvokeAsync("CheckoutSummary")
            </div>
        </form>
    </div>
</div>

 
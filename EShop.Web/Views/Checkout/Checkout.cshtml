@using EShop.Web.Components
@using EShop.Web.Controllers
@using EShop.Web.Models.Checkout
@using Microsoft.AspNetCore.Mvc.TagHelpers
@model EShop.Web.Models.Checkout.CheckoutModel
@{
    ViewData["Title"] = "Checkout";
    var getAddressUrl = Url.Action(nameof(CheckoutController.GetAddressById), "Checkout");
}
@*TODO: Once hot reload is fixed, apply appropriate landmarst throuthout the checkout.cshtml page including all the partials and components it contains.*@
<div class="section section--content-middle color-scheme-1 spacing-style" style="
            --padding-block-start: max(20px, calc(var(--spacing-scale) * 48px));
            --padding-block-end: max(20px, calc(var(--spacing-scale) * 48px))">
    <div class="checkout customer">
        <h1 class="h3">Checkout</h1>
        <checkout-flow>
            <form class="js-checkout-form" asp-action="SaveOrder" method="post">
                <div class="checkout__container">

                    <div class="checkout__main-flow">
                        <address-flow data-get-address-url="@getAddressUrl">
                            <div id="checkout-address-load"
                                 class="checkout-address">
                                <partial name="_Checkout.Address" model="Model"/>
                            </div>
                            <div id="checkout-payment-load" class="checkout__payment checkout__block">
                                <fieldset class="field-group">
                                    <legend class="field-group__label">Payment</legend>
                                    @await Component.InvokeAsync("CheckoutPaymentMethodList")
                                </fieldset>
                            </div>
                        </address-flow>
                    </div>
               
                    <div class="checkout__right">
                        @await Component.InvokeAsync("CheckoutSummary")
                    </div>
                </div>
            </form>
        </checkout-flow>
    </div>
</div>
<p>123</p>
<p>123</p>
<p>123</p>
@section Scripts{
    <partial name="_ValidationScriptsPartial"/>
}
 
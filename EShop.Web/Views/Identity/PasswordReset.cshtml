


@using EShop.Infrastructure.Extensions
@model EShop.Web.Models.Identity.PasswordResetModel
@{
    ViewData["Title"] = "Password Reset";
    Layout = "_Customer";
}

<div eh-if="Model.ResultMessage.HasValue()" role="alert">
    <p>@Model.ResultMessage</p>
</div>
<p class="visually-hidden">Enter your email to receive a link by following which you can reset your password.</p>
<form asp-action="PasswordReset" method="post">
    <div>
        <div class="field field--text">
            <input asp-for="Email" placeholder="@Html.DisplayNameFor(x => x.Email)"/>
            <label asp-for="Email">@Html.DisplayNameFor(x => x.Email)</label>
        </div>
        <span class="text-xs" asp-validation-for="Email"></span>
    </div>
    <button class="mt-8 block mx-auto button">Send a recovery letter</button>
</form>
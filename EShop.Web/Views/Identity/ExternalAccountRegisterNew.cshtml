@model EShop.Web.Models.Identity.ExternalRegistrationModel

@{
    ViewData["Title"] = "Finalizing registration";
    ViewBag.ClassToken = "register";
    Layout = "_Customer";
}
<form method="post" asp-action="ExternalAccountRegisterNew" asp-controller="Identity"
      asp-route-returnUrl="@ViewData["returnUrl"]">
    <div asp-validation-summary="ModelOnly"></div>
    <div class="field field--text">
        <input asp-for="Email" value="@Model.Email" placeholder="@Html.DisplayNameFor(x => x.Email)"/>
        <label asp-for="Email">@Html.DisplayNameFor(x => x.Email)</label>
    </div>
    <div class="field field--text">
        <input asp-for="FirstName" value="@Model.FirstName" placeholder="@Html.DisplayNameFor(x => x.FirstName)"/>
        <label asp-for="FirstName">@Html.DisplayNameFor(x => x.FirstName)</label>
    </div>
    @if (Model.LastName != null)
    {
        <div class="field field--text">
            <input asp-for="LastName" readonly placeholder="@Html.DisplayNameFor(x => x.LastName)"/>
            <label asp-for="LastName">@Html.DisplayNameFor(x => x.LastName)</label>
        </div>
    }
    else
    {
        <div class="mt-md">
            <div class="field field--text">
                @if (Model.LastNameRequired)
                {
                    <input asp-for="LastName" required id="last-name"
                           placeholder="@Html.DisplayNameFor(x => x.LastName)"/>
                }
                else
                {
                    <input asp-for="LastName" id="last-name" placeholder="@Html.DisplayNameFor(x => x.LastName)"/>
                }

                <label asp-for="LastName" class="@(Model.FirstNameRequired ? "requited" : string.Empty)">@Html.DisplayNameFor(x => x.LastName)</label>
            </div>
            <span class="text-xs" asp-validation-for="LastName"></span>
        </div>

    }

    <fieldset eh-if="Model.GenderEnabled" class="radio-group radio-group--col">
        <legend class="radio-group__label">@Html.DisplayNameFor(x => x.Gender)</legend>
        <div class="radio">
            <input asp-for="Gender" id="gender-male" type="radio" value="Male"/>
            <label for="gender-male">Male</label>
        </div>
        <div class="radio">
            <input asp-for="Gender" id="gender-female" type="radio" value="Female"/>
            <label for="gender-female">Female</label>
        </div>
    </fieldset>

    <button class="block mt-8 button mx-auto">Submit</button>

</form>
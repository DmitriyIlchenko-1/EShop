@using EShop.Core.Platform.Identity.Domain
@using EShop.Infrastructure.Extensions
@using Microsoft.AspNetCore.Identity
@using Microsoft.AspNetCore.Mvc.TagHelpers
@model EShop.Web.Models.Identity.LoginModel
@inject SignInManager<User> SignInManager

@{
    ViewData["Title"] = "Login";
    var returnUrl = ViewData["returnUrl"]?.ToString();
    Layout = "_Customer";
    ViewBag.ClassToken = "login";
}


<form asp-controller="Identity" asp-action="LogIn" asp-route-returnUrl="@returnUrl" method="post">
    <div asp-validation-summary="ModelOnly"></div>
    <input asp-for="UserLoginType" type="hidden"/>
    @if (Model.UserLoginType == UserLoginType.Username)
    {
        <div class="mt-md">
            <div class="field field--text">
                <input  asp-for="Username" required   placeholder="@Html.DisplayNameFor(x => x.Username)" />
                <label asp-for="Username" >@Html.DisplayNameFor(x => x.Username)</label>
            </div>
            <span class="text-xs" asp-validation-for="Username"></span>
        </div>
    }
    else if (Model.UserLoginType == UserLoginType.Email)
    {
        <div class="mt-md">
            <div class="field field--text">
                <input  asp-for="Email" required  placeholder="@Html.DisplayNameFor(x => x.Email)"/>
                <label asp-for="Email">@Html.DisplayNameFor(x => x.Email)</label>
            </div>
            <span class="text-xs" asp-validation-for="Email"></span>
        </div>
        
    }
    else
    {
        <div class="mt-md">
            <div class="field field--text">
                <input asp-for="UsernameOrEmail" required  placeholder="@Html.DisplayNameFor(x => x.UsernameOrEmail)"/>
                <label asp-for="UsernameOrEmail">@Html.DisplayNameFor(x => x.UsernameOrEmail)</label>
            </div>
        </div>
        <span class="text-xs" asp-validation-for="UsernameOrEmail"></span>
        
    }
    <div class="mt-md">
        <password-input-component class="password-input field field--text">
            <input asp-for="Password" id="password" required  placeholder="@Html.DisplayNameFor(x => x.Password)" class="password-input__input js-password-input-input"/>
            <label  for="password">@Html.DisplayNameFor(x => x.Password)</label>
            <button hidden type="button" aria-controls="password" class="password-input__toggle js-password-input-toggle">
                <svg aria-hidden="true" focusable="false" class="icon-reveal" width="14" height="14" xmlns="http://www.w3.org/2000/svg"
                     viewBox="0 0 24 24"
                     fill="#000000">
                    <g fill="#000000" clip-rule="evenodd">
                        <path d="M12 8a4 4 0 1 1 0 8a4 4 0 0 1 0-8m0 2a2 2 0 1 0 0 4a2 2 0 0 0 0-4"/>
                        <path d="M12 4c5.091 0 8.2 2.619 10.76 5.618l.24.28v4.204l-.24.28C20.2 17.38 17.092 20 12 20c-5.096 0-8.204-2.66-10.76-5.654l-.24-.28V9.897l.24-.28C3.8 6.62 6.908 4 12 4m0 2c-4.097 0-6.664 1.97-9 4.643v2.678C5.34 16.001 7.908 18 12 18c4.097 0 6.664-1.971 9-4.644v-2.713C18.664 7.97 16.097 6 12 6"/>
                    </g>
                </svg>
                <svg aria-hidden="true" focusable="false" class="icon-hide" width="14" height="14" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24"
                     fill="#000000">
                    <g fill="#000000">
                        <path d="M23.477 20.063h-2.829l-1.967-1.968C16.874 19.25 14.72 20 12 20c-5.096 0-8.204-2.66-10.76-5.654l-.24-.28V9.897l.24-.28c1.373-1.608 2.904-3.106 4.814-4.15L2.586 2h2.828zM7.543 6.957c-1.76.83-3.19 2.139-4.543 3.686v2.678C5.34 16.001 7.907 18 12 18c2.08 0 3.762-.512 5.223-1.363l-2.118-2.118A4 4 0 0 1 8 12a3.99 3.99 0 0 1 1.48-3.104zm3.365 3.365a2 2 0 1 0 2.768 2.768z"
                              clip-rule="evenodd"/>
                        <path d="M12 4c5.091 0 8.2 2.619 10.76 5.618l.24.28v4.204l-.24.28q-.493.58-1.019 1.133l-1.418-1.418q.343-.36.677-.74v-2.714c-2.292-2.622-4.807-4.568-8.77-4.64L10.327 4.1Q11.126 4 12 4"/>
                    </g>
                </svg>
            </button>
        </password-input-component>
        <span class="text-xs" asp-validation-for="Password"></span>
    </div>
    <div class="mt-lg">
        <input asp-for="RememberMe"  class="checkbox" type="checkbox"/>
        <label asp-for="RememberMe">Remember me</label>
    </div>
    <a asp-action="PasswordReset" class="link block fit-width mt-3 text-sm">Forgot your password?</a>
    <button class="mt-8 button block mx-auto">Sign In</button>
    <a asp-action="Register" class="link block fit-width mx-auto mt-3 text-sm">Create a new account</a>
</form>


<ul class="list-social list-unstyled mt-4">
                <form method="post">
                    @foreach (var scheme in await SignInManager.GetExternalAuthenticationSchemesAsync())
                    {
                    <li>
                        <button formmethod="post"
                                asp-action="ExternalLogin"
                                asp-controller="Identity"
                                asp-route-returnUrl=@ViewData["ReturnUrl"]
                                asp-route-provider="@scheme.Name" class="list-social__item button--unstyled">
                            <svg aria-hidden="true" focusable="false" class="icon" version="1.1" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 48 48"
                                 xmlns:xlink="http://www.w3.org/1999/xlink">
                                <path fill="#EA4335"
                                      d="M24 9.5c3.54 0 6.71 1.22 9.21 3.6l6.85-6.85C35.9 2.38 30.47 0 24 0 14.62 0 6.51 5.38 2.56 13.22l7.98 6.19C12.43 13.72 17.74 9.5 24 9.5z"></path>
                                <path fill="#4285F4"
                                      d="M46.98 24.55c0-1.57-.15-3.09-.38-4.55H24v9.02h12.94c-.58 2.96-2.26 5.48-4.78 7.18l7.73 6c4.51-4.18 7.09-10.36 7.09-17.65z"></path>
                                <path fill="#FBBC05"
                                      d="M10.53 28.59c-.48-1.45-.76-2.99-.76-4.59s.27-3.14.76-4.59l-7.98-6.19C.92 16.46 0 20.12 0 24c0 3.88.92 7.54 2.56 10.78l7.97-6.19z"></path>
                                <path fill="#34A853"
                                      d="M24 48c6.48 0 11.93-2.13 15.89-5.81l-7.73-6c-2.15 1.45-4.92 2.3-8.16 2.3-6.26 0-11.57-4.22-13.47-9.91l-7.98 6.19C6.51 42.62 14.62 48 24 48z"></path>
                                <path fill="none" d="M0 0h48v48H0z"></path>
                            </svg>
                            <span class="visually-hidden">Sign in with @scheme.DisplayName</span>
                        </button>
                    </li>
                       
                    }
                </form>
             
                 
            </ul>

    
 
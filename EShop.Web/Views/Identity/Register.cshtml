@model EShop.Web.Models.Identity.ApplicationRegistrationModel

@{
    ViewData["Title"] = "Register";
    ViewBag.ClassToken = "register";
    Layout = "_Customer";
}

<form method="post" asp-action="Register" asp-route-returnUrl="@ViewData["ReturnUrl"]">
    <div asp-validation-summary="ModelOnly"></div>
    <fieldset class="field-group">
        <legend class="field-group__label">Your personal information</legend>
        <div class="mt-md">
            <div class="field field--text">
                @if (Model.FirstNameRequired)
                {
                    <input asp-for="FirstName" required   id="first-name"
                           placeholder="@Html.DisplayNameFor(x => x.FirstName)"/>
                }
                else
                {
                    <input asp-for="FirstName" id="first-name"
                           placeholder="@Html.DisplayNameFor(x => x.FirstName)"/>
                }
                <label asp-for="FirstName"  class="@(Model.FirstNameRequired ? "requited" : string.Empty )">@Html.DisplayNameFor(x => x.FirstName)</label>
               
            </div>
            <span class="text-xs" asp-validation-for="FirstName"></span>
        </div>
        <div class="mt-md">
            <div class="field field--text">
                @if (Model.LastNameRequired)
                {
                    <input asp-for="LastName" required   id="last-name"
                           placeholder="@Html.DisplayNameFor(x => x.LastName)"/>
                }
                else
                {
                    <input asp-for="LastName"  id="last-name" placeholder="@Html.DisplayNameFor(x => x.LastName)"/>
                }

                <label asp-for="LastName" class="@(Model.FirstNameRequired ? "requited" : string.Empty )">@Html.DisplayNameFor(x => x.LastName)</label>
            </div>
            <span class="text-xs" asp-validation-for="LastName"></span>
        </div>
        
        <div eh-if="Model.UsernameEnabled" class="field field--text">
            <input asp-for="Username" id="username" placeholder="@Html.DisplayNameFor(x => x.Username)"/>
            <label asp-for="Username">@Html.DisplayNameFor(x => x.Username)</label>
        </div>
        <div class="mt-md ">
            <div class="field field--text">
                <input asp-for="Email" required   id="email"
                       placeholder="@Html.DisplayNameFor(x => x.Email)"/>
                <label asp-for="Email" class="required">@Html.DisplayNameFor(x => x.Email)</label>
            </div>
            <span class="text-xs" asp-validation-for="Email"></span>
        </div>
    </fieldset>
    <fieldset class="field-group mt-lg">
        <legend class="field-group__label">Your password</legend>
        <div class="mt-md">
            <password-input-component class="password-input field field--text">
                <input asp-for="Password" required  id="password" class="password-input__input js-password-input-input"
                       placeholder="@Html.DisplayNameFor(x => x.Password)"/>
                <label for="password" class="required">@Html.DisplayNameFor(x => x.Password)</label>
                <button hidden type="button" aria-controls="password" class="password-input__toggle js-password-input-toggle">
                    <svg aria-hidden="true" focusable="false" class="icon-reveal" width="14" height="14" xmlns="http://www.w3.org/2000/svg"
                         viewBox="0 0 24 24"
                         fill="#000000">
                        <g fill="#000000" clip-rule="evenodd">
                            <path d="M12 8a4 4 0 1 1 0 8a4 4 0 0 1 0-8m0 2a2 2 0 1 0 0 4a2 2 0 0 0 0-4"/>
                            <path d="M12 4c5.091 0 8.2 2.619 10.76 5.618l.24.28v4.204l-.24.28C20.2 17.38 17.092 20 12 20c-5.096 0-8.204-2.66-10.76-5.654l-.24-.28V9.897l.24-.28C3.8 6.62 6.908 4 12 4m0 2c-4.097 0-6.664 1.97-9 4.643v2.678C5.34 16.001 7.908 18 12 18c4.097 0 6.664-1.971 9-4.644v-2.713C18.664 7.97 16.097 6 12 6"/>
                        </g>
                    </svg>
                    <svg aria-hidden="true" focusable="false" class="icon-hide" width="14" height="14" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24"
                         fill="#000000">
                        <g fill="#000000">
                            <path d="M23.477 20.063h-2.829l-1.967-1.968C16.874 19.25 14.72 20 12 20c-5.096 0-8.204-2.66-10.76-5.654l-.24-.28V9.897l.24-.28c1.373-1.608 2.904-3.106 4.814-4.15L2.586 2h2.828zM7.543 6.957c-1.76.83-3.19 2.139-4.543 3.686v2.678C5.34 16.001 7.907 18 12 18c2.08 0 3.762-.512 5.223-1.363l-2.118-2.118A4 4 0 0 1 8 12a3.99 3.99 0 0 1 1.48-3.104zm3.365 3.365a2 2 0 1 0 2.768 2.768z"
                                  clip-rule="evenodd"/>
                            <path d="M12 4c5.091 0 8.2 2.619 10.76 5.618l.24.28v4.204l-.24.28q-.493.58-1.019 1.133l-1.418-1.418q.343-.36.677-.74v-2.714c-2.292-2.622-4.807-4.568-8.77-4.64L10.327 4.1Q11.126 4 12 4"/>
                        </g>
                    </svg>
                </button>
            </password-input-component>
            <span class="text-xs" asp-validation-for="Password"></span>
        </div>
        <div class=" mt-md">
            <password-input-component class="password-input field field--text">
                <input asp-for="ConfirmPassword" id="repeat-password" required  class="password-input__input js-password-input-input"
                       placeholder="@Html.DisplayNameFor(x => x.ConfirmPassword)"/>
                <label  for="repeat-password"  class="required">@Html.DisplayNameFor(x => x.ConfirmPassword)</label>
                <button hidden type="button" aria-controls="repeat-password" class="password-input__toggle js-password-input-toggle">
                    <svg aria-hidden="true" focusable="false" class="icon-reveal" width="14" height="14" xmlns="http://www.w3.org/2000/svg"
                         viewBox="0 0 24 24"
                         fill="#000000">
                        <g fill="#000000" clip-rule="evenodd">
                            <path d="M12 8a4 4 0 1 1 0 8a4 4 0 0 1 0-8m0 2a2 2 0 1 0 0 4a2 2 0 0 0 0-4"/>
                            <path d="M12 4c5.091 0 8.2 2.619 10.76 5.618l.24.28v4.204l-.24.28C20.2 17.38 17.092 20 12 20c-5.096 0-8.204-2.66-10.76-5.654l-.24-.28V9.897l.24-.28C3.8 6.62 6.908 4 12 4m0 2c-4.097 0-6.664 1.97-9 4.643v2.678C5.34 16.001 7.908 18 12 18c4.097 0 6.664-1.971 9-4.644v-2.713C18.664 7.97 16.097 6 12 6"/>
                        </g>
                    </svg>
                    <svg aria-hidden="true" focusable="false" class="icon-hide" width="14" height="14" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24"
                         fill="#000000">
                        <g fill="#000000">
                            <path d="M23.477 20.063h-2.829l-1.967-1.968C16.874 19.25 14.72 20 12 20c-5.096 0-8.204-2.66-10.76-5.654l-.24-.28V9.897l.24-.28c1.373-1.608 2.904-3.106 4.814-4.15L2.586 2h2.828zM7.543 6.957c-1.76.83-3.19 2.139-4.543 3.686v2.678C5.34 16.001 7.907 18 12 18c2.08 0 3.762-.512 5.223-1.363l-2.118-2.118A4 4 0 0 1 8 12a3.99 3.99 0 0 1 1.48-3.104zm3.365 3.365a2 2 0 1 0 2.768 2.768z"
                                  clip-rule="evenodd"/>
                            <path d="M12 4c5.091 0 8.2 2.619 10.76 5.618l.24.28v4.204l-.24.28q-.493.58-1.019 1.133l-1.418-1.418q.343-.36.677-.74v-2.714c-2.292-2.622-4.807-4.568-8.77-4.64L10.327 4.1Q11.126 4 12 4"/>
                        </g>
                    </svg>
                </button>
            </password-input-component>
            <span class="text-xs" asp-validation-for="ConfirmPassword"></span>
        </div>
    </fieldset>
    <fieldset class="field-group mt-lg">
        <legend class="field-group__label">Additional details</legend>

        <fieldset eh-if="Model.GenderEnabled" class="radio-group radio-group--col">
            <legend class="radio-group__label">@Html.DisplayNameFor(x => x.Gender)</legend>
            <div class="radio">
                <input asp-for="Gender" id="gender-male" type="radio" value="Male"/>
                <label for="gender-male">Male</label>
            </div>
            <div class="radio">
                <input asp-for="Gender" id="gender-female" type="radio" value="Female"/>
                <label for="gender-female">Female</label>
            </div>
        </fieldset>
    </fieldset>
    <button class="block mt-8 button mx-auto">Create</button>
    <span class="block fit-width mx-auto mt-5 text-sm">
        Have an account?
        <a class="link" asp-action="Login" asp-controller="Identity">
            Log in
        </a>
    </span>
</form>


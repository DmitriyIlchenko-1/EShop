@using EShop.Web.Controllers
@using Microsoft.AspNetCore.Mvc.TagHelpers
@model EShop.Web.Models.Checkout.ShoppingCartModel

@{
    ViewData["Title"] = "Cart";
}
<section class="section section--content-middle color-scheme-1 spacing-style"
         style=" --padding-block-start: max(20px, calc(var(--spacing-scale) * 68px)); --padding-block-end:max(20px, calc(var(--spacing-scale) * 68px))">

    <div class="section__header">
        <h1 class="h2">Your cart</h1>
    </div>

    <form class="js-cart-form"
          data-update-cart-url="@Url.Action(nameof(ShoppingCartController.UpdateCartItem), "ShoppingCart")"
          data-remove-cart-item-url="@Url.Action(nameof(ShoppingCartController.RemoveCartItem), "ShoppingCart")">
        <div class="cart @(@Model.Items.Count == 0 ? "cart--empty" : "")">
            <partial name="_Cart" model="Model"/>
            <div eh-if="@Model.Items.Count != 0" class="cart__summary" id="cart-summary">
                <partial name="_ShoppingCart.TotalSummary" model="Model"/>
            </div>
        </div>
    </form>

</section>
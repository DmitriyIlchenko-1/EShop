@using EShop.Web.Controllers
@using Microsoft.AspNetCore.Mvc.Routing
@using Microsoft.AspNetCore.Mvc.TagHelpers
@model EShop.Web.Models.Checkout.ShoppingCartModel



<cart-drawer data-partial="cartDrawer" id="cart-drawer" aria-labelledby="cart-drawer-label"  class="drawer drawer--right cart-drawer flex flex-col w-full radius-lg shadow-md   top-0 right-0" style="--color-bg: var(--color-bg-light)">
    <div class="drawer__header cart-drawer__header flex items-center justify-between bg-light">
        <h2 id="cart-drawer-label" class="h3 m-0">Your cart</h2>
        <button  class="drawer__close-btn interactive-button animate-close">
            <span class="visually-hidden">Close cart</span>
            <svg aria-hidden="true" focusable="false" class="icon icon-close" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20">
                <path fill="currentColor" d="M10 8.586L2.929 1.515L1.515 2.929L8.586 10l-7.071 7.071l1.414 1.414L10 11.414l7.071 7.071l1.414-1.414L11.414 10l7.071-7.071l-1.414-1.414L10 8.586z"></path>
            </svg>
        </button>
    </div>
    <div class="drawer__content flex-auto @(@Model.Items.Count == 0 ? "drawer__content--flex items-center" : "")">
        <div class="cart-drawer__summary" remove-white-space>
            <div eh-if="@Model.Items.Count > 0">
                <a asp-action="Cart" asp-controller="ShoppingCart" class="button flex items-center justify-center gap-sm w-full">
                    <svg class="icon" width="24" height="24" focusable="false" aria-hidden="true"
                         xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24">
                        <g fill="currentColor">
                            <path d="M10 13.25a.75.75 0 0 0 0 1.5h4a.75.75 0 1 0 0-1.5h-4Z"/>
                            <path fill-rule="evenodd"
                                  d="M14.665 2.33a.75.75 0 0 1 1.006.335l1.813 3.626c.428.022.817.055 1.17.106c1.056.151 1.93.477 2.551 1.245c.621.769.757 1.691.684 2.755c-.07 1.031-.35 2.332-.698 3.957l-.451 2.107c-.235 1.097-.426 1.986-.666 2.68c-.25.725-.58 1.32-1.142 1.775c-.562.455-1.214.652-1.974.745c-.73.089-1.64.089-2.76.089H9.802c-1.122 0-2.031 0-2.761-.089c-.76-.093-1.412-.29-1.974-.745c-.563-.455-.892-1.05-1.142-1.774c-.24-.695-.43-1.584-.666-2.68l-.451-2.107c-.348-1.626-.627-2.927-.698-3.958c-.073-1.064.063-1.986.684-2.755c.62-.768 1.494-1.094 2.55-1.245c.353-.05.743-.084 1.17-.106L8.33 2.665a.75.75 0 0 1 1.342.67l-1.46 2.917c.364-.002.747-.002 1.149-.002h5.278c.402 0 .785 0 1.149.002l-1.459-2.917a.75.75 0 0 1 .335-1.006ZM5.732 7.858l-.403.806a.75.75 0 1 0 1.342.67l.787-1.574c.57-.01 1.22-.011 1.964-.011h5.156c.744 0 1.394 0 1.964.01l.787 1.575a.75.75 0 0 0 1.342-.67l-.403-.806l.174.023c.884.127 1.317.358 1.597.703c.275.34.41.803.356 1.665H3.605c-.054-.862.081-1.325.356-1.665c.28-.345.713-.576 1.597-.703l.174-.023ZM4.288 14.1a81.117 81.117 0 0 1-.481-2.35h16.386a82.85 82.85 0 0 1-.482 2.35l-.428 2c-.248 1.155-.42 1.954-.627 2.552c-.2.58-.404.886-.667 1.098c-.262.212-.605.348-1.212.422c-.629.077-1.447.078-2.628.078H9.85c-1.18 0-1.998-.001-2.627-.078c-.608-.074-.95-.21-1.212-.422c-.263-.212-.468-.519-.667-1.098c-.207-.598-.38-1.397-.627-2.552l-.429-2Z"
                                  clip-rule="evenodd"/>
                        </g>
                    </svg>
                    <span>
                    View cart - @Html.Raw(Model.CartSubtotal.SubtotalWithDiscount)
                </span>
                </a>
            </div>
        </div>
        <div class="cart-drawer__content">
            <form class="js-cart-form"
                  data-update-cart-url="@Url.Action(nameof(ShoppingCartController.UpdateCartItem), "ShoppingCart")"
                  data-remove-cart-item-url="@Url.Action(nameof(ShoppingCartController.RemoveCartItem), "ShoppingCart")">
                <partial name="_Cart" model="Model"/>
            </form>
            
        </div>
    </div>
</cart-drawer>
@using EShop.Web.Common.TagHelpers
@using Microsoft.AspNetCore.Mvc.TagHelpers
@model EShop.Web.Models.Catalog.ProductSummaryModel

@{
    var items = Model.Items;
    var anyExist = items.Any();
}

<div class="section__header">
    <h3 class="h4 mb-0 text-start">Featured products</h3>
</div>
<ul eh-if="anyExist" class="list-unstyled resource-list resource-list--grid
            grid-cols-2 md:grid-cols-3 xl:grid-cols-4"
    style="
                --resource-list-column-gap-desktop: 24px;
                 --resource-list-row-gap-desktop: 20px;">

    @foreach (var item in items)
    {
        <partial name="_Product.Card" model="item"/>
    }
</ul>

 
 
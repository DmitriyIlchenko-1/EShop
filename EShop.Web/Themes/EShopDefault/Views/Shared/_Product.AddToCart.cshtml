@using EShop.Web.Controllers
@model EShop.Web.Models.Catalog.ProductDetailModel

@{
    var product = Model;
    var addToCartDisabled = !Model.IsAvailable || Model.StockQuantity == 0;
    Console.WriteLine();
}
<product-form>
    <form method="post" class="js-product-form" asp-route-productId="@product.Id"
          asp-action="@nameof(ShoppingCartController.AddProduct)" asp-controller="ShoppingCart">
        <div class="product-info__add-to-cart">
            <quantity-selector id="quantity-selector" class="quantity-selector">
                <button tabindex="-1" aria-hidden="true" class="button button-unstyled quantity-minus"
                        disabled="@addToCartDisabled">

                    <svg aria-hidden="true" focusable="false" class="icon-plus" width="15" height="15"
                         viewBox="0 0 24 24" fill="none"
                         xmlns="http://www.w3.org/2000/svg">
                        <g
                            id="SVGRepo_bgCarrier" stroke-width="0"></g>
                        <g id="SVGRepo_tracerCarrier"
                           stroke-linecap="round"
                           stroke-linejoin="round"></g>
                        <g
                            id="SVGRepo_iconCarrier">
                            <path d="M6 12L18 12" stroke="#000000" stroke-width="2"
                                  stroke-linecap="round"
                                  stroke-linejoin="round"></path>
                        </g>
                    </svg>

                </button>
                <label class="visually-hidden" for="quantity">Enter quantity</label>

                <input id="quantity" name="quantity" min="@Model.MinAddToCartNumber"
                       max="@Model.MaxAddToCartNumber" type="number" disabled="@addToCartDisabled"/>
                <button tabindex="-1" aria-hidden="true" class="button button-unstyled quantity-plus"
                        disabled="@addToCartDisabled">

                    <svg aria-hidden="true" focusable="false" class="icon-minus" width="15" height="15"
                         viewBox="0 0 24 24" fill="none"
                         xmlns="http://www.w3.org/2000/svg">
                        <g
                            id="SVGRepo_bgCarrier" stroke-width="0"></g>
                        <g id="SVGRepo_tracerCarrier"
                           stroke-linecap="round"
                           stroke-linejoin="round"></g>
                        <g
                            id="SVGRepo_iconCarrier">
                            <path d="M4 12H20M12 4V20" stroke="#000000"
                                  stroke-width="2" stroke-linecap="round"
                                  stroke-linejoin="round"></path>
                        </g>
                    </svg>

                </button>
            </quantity-selector>
            <button @(@addToCartDisabled ? "disabled" : "") name="add" class="button product-info__add-btn">Add to
                cart
            </button>
        </div>
    </form>
</product-form>
 
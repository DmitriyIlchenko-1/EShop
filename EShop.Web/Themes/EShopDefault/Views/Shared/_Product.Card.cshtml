@model EShop.Web.Models.Catalog.ProductSummaryItemModel

@{
    var showVariants = Model.ProductVariantAttributes is { Count: > 0 };
    var parent = Model.Parent;
}
<li class="resource-list__item">
    <div class="product-card">
        <div
            class="color-scheme-2 product-grid__card layout-panel-flex  layout-panel-flex--column   border-style gap-style">
            <div class="product-card__compare text-sm pb-3">
                <input class="checkbox product-card__compare-checkbox" type="checkbox" id="compare"
                       name=""/>
                <label for="compare">Compare</label>
            </div>

            <div class="product-card__top-content">
                <ul class="product-card__labels list-unstyled top-0 left-0 ">
                    <li class="product-card__label-wrapper flex">
                                        <span
                                            class="product-card__label product-card__label--refurbished product-card__label--rounded">
                                        <svg class="icon" aria-hidden="true" focusable="false" width="16" height="16"
                                             viewBox="0 0 48 48"
                                             fill="none" xmlns="http://www.w3.org/2000/svg"><g
                                                id="SVGRepo_bgCarrier" stroke-width="0"></g><g
                                                id="SVGRepo_tracerCarrier" stroke-linecap="round"
                                                stroke-linejoin="round"></g><g id="SVGRepo_iconCarrier"> <rect
                                                    width="48" height="48" fill="white" fill-opacity="0.01"></rect> <path
                                                    d="M33.5264 19.5L25.793 6.10544C25.01 4.74918 23.0425 4.77835 22.3 6.15723L17 16"
                                                    stroke="#000000" stroke-width="4.8" stroke-linecap="round"
                                                    stroke-linejoin="round"></path> <path
                                                    d="M25 40H41.4209C42.9855 40 43.9442 38.2843 43.1242 36.9518L37 27"
                                                    stroke="#000000" stroke-width="4.8" stroke-linecap="round"
                                                    stroke-linejoin="round"></path> <path
                                                    d="M13 23L4.77297 36.986C3.98869 38.3192 4.95001 40 6.49684 40H17"
                                                    stroke="#000000" stroke-width="4.8" stroke-linecap="round"
                                                    stroke-linejoin="round"></path> <path d="M29 36L25 40L29 44"
                                                                                          stroke="#000000"
                                                                                          stroke-width="4.8"
                                                                                          stroke-linecap="round"
                                                                                          stroke-linejoin="round"></path> <path
                                                    d="M28 18.2004L33.4641 19.6646L34.9282 14.2004" stroke="#000000"
                                                    stroke-width="4.8" stroke-linecap="round"
                                                    stroke-linejoin="round"></path> <path
                                                    d="M7.5 24.4641L12.9641 23L14.4282 28.4641" stroke="#000000"
                                                    stroke-width="4.8" stroke-linecap="round"
                                                    stroke-linejoin="round"></path> </g></svg>
                                            Refurbished
                                        </span>
                    </li>
                    <li class="product-card__label-wrapper  flex">
                                        <span
                                            class="product-card__label product-card__label--sale product-card__label--rounded">
                                           <svg class="icon align-middle" focusable="false" aria-hidden="true"
                                                width="16" height="16"
                                                version="1.0"
                                                id="Layer_1" xmlns="http://www.w3.org/2000/svg"
                                                xmlns:xlink="http://www.w3.org/1999/xlink"
                                                viewBox="-2.56 -2.56 69.12 69.12" enable-background="new 0 0 64 64"
                                                xml:space="preserve" fill="#000000" transform="rotate(90)"><g
                                                   id="SVGRepo_bgCarrier" stroke-width="0"></g><g
                                                   id="SVGRepo_tracerCarrier" stroke-linecap="round"
                                                   stroke-linejoin="round" stroke="#CCCCCC" stroke-width="0.128"></g><g
                                                   id="SVGRepo_iconCarrier"> <g> <polygon fill="none" stroke="#000000"
                                                                                          stroke-width="5.3759999999999994"
                                                                                          stroke-miterlimit="10"
                                                                                          points="25,1 63,39 39,63 1,25 1,1 "></polygon> <circle
                                                           fill="none" stroke="#000000"
                                                           stroke-width="5.3759999999999994"
                                                           stroke-miterlimit="10" cx="17" cy="17"
                                                           r="6"></circle> </g> </g></svg>
                                            <span class="align-middle">Up to 15% off</span>
                                        </span>
                    </li>

                </ul>
                <!--The Media part of the product card-->
                <div class="card-gallery spacing-style border-style"
                     style="--padding-block-start: 0px;
                                     --padding-block-end: 0px;
                                     --padding-inline-start: 0px;
                                     --padding-inline-end: 0px;
--gallery-aspect-ratio: 4 / 5"> <!--1, 16/9, 4/5-->
                    <div class="slideshow">
                        <div class="slideshow__container">
                            <div class="slideshow-arrows" position="center">
                                <button aria-label="Previous slide"
                                        class=" button-unstyled--transparent slideshow__control button--unstyled slideshow__control--previous flip-x">
                                    <svg aria-hidden="true" focusable="false" class="icon icon-arrow"
                                         viewBox="0 0 24 24" fill="none"
                                         xmlns="http://www.w3.org/2000/svg">
                                        <g id="SVGRepo_bgCarrier" stroke-width="0"></g>
                                        <g id="SVGRepo_tracerCarrier" stroke-linecap="round"
                                           stroke-linejoin="round"></g>
                                        <g id="SVGRepo_iconCarrier">
                                            <path
                                                d="M7.82054 20.7313C8.21107 21.1218 8.84423 21.1218 9.23476 20.7313L15.8792 14.0868C17.0505 12.9155 17.0508 11.0167 15.88 9.84497L9.3097 3.26958C8.91918 2.87905 8.28601 2.87905 7.89549 3.26958C7.50497 3.6601 7.50497 4.29327 7.89549 4.68379L14.4675 11.2558C14.8581 11.6464 14.8581 12.2795 14.4675 12.67L7.82054 19.317C7.43002 19.7076 7.43002 20.3407 7.82054 20.7313Z"

                                                fill="currentColor"></path>
                                        </g>
                                    </svg>
                                </button>
                                <button aria-label="Next slide"
                                        class="button-unstyled--transparent slideshow__control button--unstyled slideshow__control--next">
                                    <svg aria-hidden="true" focusable="false" class="icon icon-arrow"
                                         viewBox="0 0 24 24" fill="none"
                                         xmlns="http://www.w3.org/2000/svg">
                                        <g id="SVGRepo_bgCarrier" stroke-width="0"></g>
                                        <g id="SVGRepo_tracerCarrier" stroke-linecap="round"
                                           stroke-linejoin="round"></g>
                                        <g id="SVGRepo_iconCarrier">
                                            <path
                                                d="M7.82054 20.7313C8.21107 21.1218 8.84423 21.1218 9.23476 20.7313L15.8792 14.0868C17.0505 12.9155 17.0508 11.0167 15.88 9.84497L9.3097 3.26958C8.91918 2.87905 8.28601 2.87905 7.89549 3.26958C7.50497 3.6601 7.50497 4.29327 7.89549 4.68379L14.4675 11.2558C14.8581 11.6464 14.8581 12.2795 14.4675 12.67L7.82054 19.317C7.43002 19.7076 7.43002 20.3407 7.82054 20.7313Z"
                                                fill="currentColor"></path>
                                        </g>
                                    </svg>
                                </button>
                            </div>
                            <!--TODO: aria-hidden on individual slides if not in the focus? (all of them but one currently displayed)-->
                            <div class="slideshow__slides">
                                <div
                                    class="slideshow__slide product-media-container media-fit product-media-container--image">
                                    <div class="product-media">
                                        <!--TODO: I'll add the sizes and srcset attributes when I start rendering this html though the backend.-->
                                        <img class="product-media__image" loading="eager"
                                             fetchpriority="auto"

                                             src="assets/chris-kursikowski-aLGEWa9SOtI-unsplash(1).jpg"
                                             alt=""/>
                                    </div>
                                </div>
                                <div
                                    class="slideshow__slide product-media-container media-fit product-media-container--image">
                                    <div class="product-media">
                                        <img class="product-media__image" loading="lazy"
                                             fetchpriority="auto"
                                             width="250"
                                             height="400"
                                             src="assets/Apple-iPhone-15-Black-frontimage.jpg" alt=""/>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
                <!---->
            </div>


            <div class="product-card__main-content">


                <p eh-if="parent.ShowBrand" class="product-card__ribbon-text text-sm mb-1"><span
                        class="visually-hidden">Brand:</span>@Model.Brand.Name
                </p>


                <div class="paragraph mb-1">
                    <h2 class="product-card__heading m-0">
                        <a href="#" class="product-card__link">
                            @Model.Name
                        </a>
                    </h2>
                </div>
                <div eh-if="@(parent.ShowRating && Model.TotalReviews > 0)" class="rating">
                     @{
                         var ratingPercent = ((Model.RatingSum * 100) / Model.TotalReviews) / 5;
                     }
                    <div role="img" aria-label="@(Model.RatingSum / Model.TotalReviews) out of 5.0 stars."
                         class="rating__star-container inline-block align-middle">
                        <span style="--rating: @ratingPercent; --rating-max: 5"
                              class="rating__stars ">&#9733;&#9733;&#9733;&#9733;&#9733;</span>
                    </div>
                    <p class="rating-count inline-block align-middle text-sm m-0">
                        <span aria-hidden="true">@Model.TotalReviews</span>
                        <span class="visually-hidden">@Model.TotalReviews reviews in total</span>
                    </p>
                </div>

                <p class="price mt-2">
                                            <span class="price__current"><span
                                                    class="visually-hidden">Sale price</span>$394.00</span>
                    <s class="price__regular"><span class="visually-hidden">Old price</span>$455.44</s>
                </p>

                <p data-inventory-level="normal"
                   class="product-card__inventory-container text-xs mt-3">

                    <svg aria-hidden="true" width="25" height="25"
                         class="product-card__inventory-indicator" version="1.1"
                         xmlns="http://www.w3.org/2000/svg" xmlns:xlink="http://www.w3.org/1999/xlink">
                        <circle fill="currentColor" class="pulser" cx="12.5" cy="12.5" r="4"></circle>
                        <circle fill="currentColor" class="core" cx="12.5" cy="12.5" r="4"></circle>

                    </svg>
                    <span class="visually-hidden">Stock information - </span>
                    Only 44 left
                </p>

                <partial name="_Product.Variants" model="Model.ProductVariantAttributes"/>
            </div>

            <div class="card__cta">
                <div class="product-form">
                    <form method="post" action="cart/add">
                        <button class="button-secondary w-full">
                            <span class="cta-button-text">Add to Cart</span>
                        </button>
                    </form>
                </div>
            </div>
        </div>


    </div>
</li>   